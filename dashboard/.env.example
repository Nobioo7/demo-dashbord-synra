NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keep this value identical on the dashboard and FastAPI service.
SYNRA_SESSION_SECRET=

# Server-only backend URL used by the authenticated Next.js proxy.
SYNRA_BACKEND_URL=http://127.0.0.1:8000

# Public API origin used only for client connection snippets and extension builds.
NEXT_PUBLIC_SYNRA_API_BASE_URL=http://127.0.0.1:8000/api/v1
