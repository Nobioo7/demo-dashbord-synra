NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keep this value identical on the dashboard and FastAPI service.
SYNRA_SESSION_SECRET=

# Local standalone-dashboard URL used by the authenticated Next.js proxy.
# Vercel Services injects this from the dashboard -> backend binding; do not set it in Vercel.
SYNRA_BACKEND_URL=http://127.0.0.1:8000

# Optional public API URL for client connection snippets. Vercel defaults to the same-origin /api/v1 route.
NEXT_PUBLIC_SYNRA_API_BASE_URL=http://127.0.0.1:8000/api/v1
