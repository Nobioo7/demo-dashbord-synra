# Run locally with APP_ENV=development. Production should set APP_ENV=production.
APP_ENV=development

# Supabase service-role credentials. Never expose SUPABASE_KEY to the dashboard.
SUPABASE_URL=
SUPABASE_KEY=

# Must match dashboard/SYNRA_SESSION_SECRET; generate a long random secret.
SYNRA_SESSION_SECRET=

# Public dashboard origin used for CORS in production.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=

# AgentMemory service connection. Set the deployed HTTPS service URL in production.
AGENTMEMORY_URL=http://localhost:3111
AGENTMEMORY_TOKEN=
AGENTMEMORY_TIMEOUT_SECONDS=3.0

# GitHub integration settings. Sync mode can be auto, live, or mock.
GITHUB_TOKEN=
GITHUB_OWNER=Nobioo7
GITHUB_REPO=Saynra-software-
GITHUB_SYNC_MODE=auto

# Gmail integration settings (OAuth is optional until configured).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN=
